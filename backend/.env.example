MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.vklvy.mongodb.net/xclone-db?retryWrites=true&w=majority&appName=Cluster0"

NEXTAUTH_URL="next-app-port"
NEXTAUTH_SECRET="your-nextauth-secret"
BACKEND_JWT_SECRET="shared-secret-with-frontend"
FRONTEND_URL="http://localhost:3000"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
MEDIA_ALLOW_UNREGISTERED_CLOUDINARY="false"

# Disables apiLimiter/writeLimiter/mediaLimiter so a local k6 load test (all
# requests from one IP) doesn't get 429s from per-IP rate limiting. Only
# takes effect outside production. Never set true in a deployed environment.
LOAD_TEST_DISABLE_RATE_LIMITS="false"
